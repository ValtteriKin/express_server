### Create a new Todo
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "first update",
    "description": "OpenAPI + README examples",
    "state": "todo"
}

### Create a new Todo with no title
POST http://localhost:3000/todos
Content-Type: application/json

{
    "description": "OpenAPI + README examples",
    "state": "banana"
}

### Create a new Todo with invalid title type
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": 123,
    "description": "OpenAPI + README examples",
    "state": "done"
}

### Create a new Todo with no state
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Write README files",
    "description": "OpenAPI + README examples",
}
### Create a new Todo with invalid state
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Write README files",
    "description": "OpenAPI + README examples",
    "state": "no"
}

### GET all Todos
GET http://localhost:3000/todos


### GET todos with state doing
GET http://localhost:3000/todos?state=doing

### Get todos with state done
GET http://localhost:3000/todos?state=done

### Get todos with incorect state 
GET http://localhost:3000/todos?state=banana

### Get todos with id
GET http://localhost:3000/todos/7cc82fc7-ab07-4753-b2c9-2b6b485a48f3

### Get todos with invalid state
GET http://localhost:3000/todos?state=invalid

### Get todos with no id
GET http://localhost:3000/todos/

### Update a todo
PUT http://localhost:3000/todos/b30a2511-5dbc-4f5d-bc19-03d1e101ce5c
Content-Type: application/json

{
    "title": "Updated API documentation",
    "state": "done"
}

### Update a todo with no title
PUT http://localhost:3000/todos/b30a2511-5dbc-4f5d-bc19-03d1e101ce5c
Content-Type: application/json

{
    "title": "",
    "state": "done"
}

### Update a todo with invalid title type
PUT http://localhost:3000/todos/b30a2511-5dbc-4f5d-bc19-03d1e101ce5c
Content-Type: application/json

{
    "title": 123,
    "state": ""
}

### Update a todo with invalid state
PUT http://localhost:3000/todos/b30a2511-5dbc-4f5d-bc19-03d1e101ce5c
Content-Type: application/json

{
    "title": "test todo",
    "state": "done",
    "description": "banana"
}

### Update a todo with empty body
PUT http://localhost:3000/todos/b30a2511-5dbc-4f5d-bc19-03d1e101ce5c
Content-Type: application/json

{
 

}
### Delete a todo
DELETE http://localhost:3000/todos/d096c9b0-d5c6-4e9e-a05d-909a861a49d4

### Delete a todo with wrong id
DELETE http://localhost:3000/todos/invalid